{
  "name": "dsh-era-bridge",
  "version": "0.4.2",
  "private": true,
  "description": "DeepSeek Harness plugin that reads and controls a managed Emuera/Era game instance through a local bridge.",
  "keywords": ["dsh", "dsh-plugin", "emuera", "era", "game-bridge"],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "scripts/*.ps1",
    "bridge/*.cs",
    "bridge/net8/EraBridgeHook/*.cs",
    "bridge/net8/EraBridgeHook/*.csproj",
    "legacy/*.ps1",
    "tests/*.ps1",
    "tests/*.mjs",
    "tests/*.cs",
    "tests/*.csproj",
    "tests/fixtures/*.txt",
    "erabridge.config.example.json",
    "README.md",
    "TEST-REPORT.md",
    "docs/*.md",
    "LICENSE"
  ],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } }
}
